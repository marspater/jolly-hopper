{
    "manifest_version": 3,
    "name": "__MSG_extension_name__",
    "version": "1.0",
    "default_locale": "en",
    "description": "__MSG_extension_description__",
    "permissions": [
        "contextMenus",
        "tabs",
        "storage",
        "alarms"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "siphon@marspater.github.io",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "action": {
        "default_title": "__MSG_context_download__",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}
